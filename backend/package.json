{
  "name": "soft-bio-backend",
  "version": "1.0.0",
  "description": "軟筋生物預購系統後端 API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "npm run prisma:db-push",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:db-push": "prisma db push --schema prisma/schema.prisma",
    "prisma:migrate-deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "build": "npm run prisma:generate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@prisma/client": "^6.19.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "ecommerce",
    "preorder",
    "api",
    "soft-bio"
  ],
  "author": "Soft Bio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/soft-bio-system.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/soft-bio-system/issues"
  },
  "homepage": "https://your-domain.com"
}
